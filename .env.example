# ---------------------------------------------------------------
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------

# --- Groq (the agent's LLM) -------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Data source ------------------------------------------------
# simulator  = physics-based fake data (use until your friend's data arrives)
# thingspeak = live data from your friend's ESP32
# csv        = a CSV file he exports for you
DATA_SOURCE=simulator

# --- ThingSpeak (fill in when your friend gives you the channel) -
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_TALKBACK_ID=
THINGSPEAK_TALKBACK_API_KEY=

# --- CSV source (if DATA_SOURCE=csv) ----------------------------
CSV_PATH=data/history.csv

# --- Neo4j (correlation graph) ----------------------------------
# Optional. Leave blank and the app computes correlations with pandas
# instead. Free cloud instance: https://console.neo4j.io  (AuraDB Free)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Site / hardware constants (ask your friend to confirm) ------
SITE_LATITUDE=15.85
SITE_LONGITUDE=74.50
SITE_TIMEZONE_OFFSET=5.5
PANEL_RATED_W=50
PANEL_AREA_M2=0.35
PANEL_TEMP_COEFF=-0.0040
BATTERY_NOMINAL_V=12.0
BATTERY_CAPACITY_AH=7.0
BATTERY_V_FULL=12.7
BATTERY_V_EMPTY=11.8
BATTERY_MAX_DOD=0.60
TARIFF_PER_KWH=8.0
GRID_CO2_KG_PER_KWH=0.71
